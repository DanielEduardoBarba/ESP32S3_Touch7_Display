# ESP-IDF build artifacts (per-project, generated by `idf.py build`)
firmware/*/build/
firmware/*/sdkconfig
firmware/*/sdkconfig.old
firmware/*/managed_components/
# Tracks which --variant (7/7b) a stage was last built for (see build.sh's
# ensure_variant_consistency()) -- local build state, not source.
firmware/*/.build_variant
# NOTE: dependencies.lock is intentionally NOT ignored -- ESP-IDF's own
# recommendation is to commit it, so everyone builds with the exact same
# resolved component versions (like a package-lock.json for idf_component.yml).

# Node / Vite
web/node_modules/
web/dist/

# Python (tools/dev_monitor.py)
__pycache__/
*.pyc

# Editor / OS
.vscode/
.DS_Store
Thumbs.db
*.log
