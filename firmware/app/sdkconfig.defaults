# App-stage-only sdkconfig overrides (on top of ../common/sdkconfig.defaults).

# Networking
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# HTTP server: allow enough concurrent sockets for the SPA + a couple of
# XHR/API calls in flight at once, and large enough URI/header buffers.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_WS_SUPPORT=y

# More LVGL widgets/fonts used by the app's UI (header bar, dropdowns, modal,
# on-screen keyboard) beyond the common defaults.
CONFIG_LV_FONT_MONTSERRAT_22=y
